# Copy these names into Coolify environment variables. Do not commit real values.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=REPLACE_WITH_COOLIFY_SECRET
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PRIVATE_POSTGRES_HOST:5432/REPLACE_DATABASE

# External effects remain blocked during base homologation.
VIDALYS_DEMO_MODE=1

# Replace with the homologation hostname assigned in Coolify.
ALLOWED_HOSTS=homolog.example.invalid
CSRF_TRUSTED_ORIGINS=https://homolog.example.invalid
CORS_ALLOWED_ORIGINS=https://homolog.example.invalid

# Redis is internal to docker-compose.homologation.yml.
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# Conservative initial runtime sizing; tune only with evidence.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
